{
  "name": "streamsicle",
  "version": "1.0.27",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3968 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3968 --hostname 0.0.0.0",
    "lint": "eslint",
    "seed": "npx tsx prisma/seed.ts",
    "sync": "npx tsx --env-file=.env src/scripts/sync-cli.ts",
    "sync:discover": "npx tsx --env-file=.env src/scripts/sync-cli.ts discover",
    "sync:pull": "npx tsx --env-file=.env src/scripts/sync-cli.ts pull",
    "sync:all": "npm run sync:discover && npm run sync:pull",
    "sync:status": "npx tsx --env-file=.env src/scripts/sync-cli.ts status",
    "test:setup": "bash e2e/setup-test-db.sh",
    "test:build": "DATABASE_URL=\"postgresql://andrew@localhost:5432/streamsicle_test?host=/var/run/postgresql\" npx next build",
    "test": "npm run test:build && npx playwright test",
    "test:ui": "npm run test:build && npx playwright test --ui"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "next": "16.3.7",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
