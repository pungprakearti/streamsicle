{
  "name": "streamsicle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3968",
    "build": "next build",
    "start": "next start --port 3968",
    "lint": "eslint",
    "seed": "npx tsx prisma/seed.ts",
    "sync": "npx tsx --env-file=.env src/scripts/sync-cli.ts",
    "sync:discover": "npx tsx --env-file=.env src/scripts/sync-cli.ts discover",
    "sync:pull": "npx tsx --env-file=.env src/scripts/sync-cli.ts pull",
    "sync:all": "npm run sync:discover && npm run sync:pull",
    "sync:status": "npx tsx --env-file=.env src/scripts/sync-cli.ts status"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "next": "16.3.7",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
